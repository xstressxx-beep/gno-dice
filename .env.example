# Copie ce fichier en ".env.local" pour le développement local.
# Sur Vercel : Project Settings > Environment Variables (mêmes noms).
# Toutes ces variables sont publiques (visibles dans le navigateur) : n'y mets
# jamais de clé privée ni de phrase secrète.

# Chemin du contrat déployé, affiché par la page /admin après le déploiement.
# Exemple : gno.land/r/g1abc...xyz/gnodice
NEXT_PUBLIC_GNODICE_REALM=

# Réseau Gno. Par défaut : le testnet Onyx (même code que le mainnet, faucet gratuit).
NEXT_PUBLIC_GNO_CHAIN_ID=onyx-1
NEXT_PUBLIC_GNO_CHAIN_NAME=Gno.land Onyx (testnet)
NEXT_PUBLIC_GNO_RPC_URL=https://rpc.onyx.testnets.gno.land:443
NEXT_PUBLIC_GNOWEB_URL=https://onyx.testnets.gno.land
NEXT_PUBLIC_FAUCET_URL=https://faucet.gno.land

# Pour le mainnet (plus tard, quand tout est validé) :
# NEXT_PUBLIC_GNO_CHAIN_ID=gnoland-1
# NEXT_PUBLIC_GNO_CHAIN_NAME=Gno.land
# NEXT_PUBLIC_GNO_RPC_URL=https://rpc.gno.land:443
# NEXT_PUBLIC_GNOWEB_URL=https://gno.land
# NEXT_PUBLIC_FAUCET_URL=
